// Šema baze — MongoDB (Prisma MongoDB konektor).
// Prisma nad MongoDB nema migracije: evolucija šeme se vodi ručno u SEMA.md.
// Primjena promjena: `npm run db:push`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Osnovni entiteti                                                    [M1]
// ---------------------------------------------------------------------------

enum Uloga {
  ADMIN
  REVIZOR
  KONTAKT_OSOBA
}

enum TipProcjene {
  COBIT
  IT_UPITNIK
}

enum StatusProcjene {
  U_TOKU
  ZAKLJUCENA
}

model Institucija {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  naziv        String   @unique
  kontaktOsoba String
  email        String
  telefon      String
  kreiranoDana DateTime @default(now())

  korisnici Korisnik[]
  procjene  Procjena[]
}

model Korisnik {
  id            String       @id @default(auto()) @map("_id") @db.ObjectId
  email         String       @unique
  lozinkaHash   String
  ime           String
  uloga         Uloga
  institucijaId String?      @db.ObjectId
  institucija   Institucija? @relation(fields: [institucijaId], references: [id])
  kreiranoDana  DateTime     @default(now())

  kreiraneProcjene Procjena[] @relation("KreiraoProcjenu")
}

model Procjena {
  id             String         @id @default(auto()) @map("_id") @db.ObjectId
  institucijaId  String         @db.ObjectId
  institucija    Institucija    @relation(fields: [institucijaId], references: [id])
  godina         Int
  tip            TipProcjene
  status         StatusProcjene @default(U_TOKU)
  kreiraoId      String         @db.ObjectId
  kreirao        Korisnik       @relation("KreiraoProcjenu", fields: [kreiraoId], references: [id])
  kreiranoDana   DateTime       @default(now())
  zakljucenoDana DateTime?

  @@unique([institucijaId, godina, tip])
}

// ---------------------------------------------------------------------------
// COBIT modul                                                          [M2]
// ---------------------------------------------------------------------------

enum CobitVrijednost {
  NE // 0
  UGLAVNOM_NE // 0.33
  UGLAVNOM_DA // 0.66
  DA // 1
}

/// Izjave se ugnježđuju u proces: katalog je nepromjenljiv i uvijek se čita
/// u cjelini, pa je jedan upit po ekranu bolji od spajanja kolekcija.
type CobitIzjava {
  kod          String // stabilan čitljiv kod, npr. PO1-N2-3
  nivoZrelosti Int // 0–5, VEĆE = BOLJE
  redniBroj    Int
  tekst        String
}

model CobitProces {
  id        String        @id @default(auto()) @map("_id") @db.ObjectId
  kod       String        @unique // PO1, DS5, ME1…
  naziv     String
  domen     String // PO | AI | DS | ME
  redniBroj Int
  izjave    CobitIzjava[]
}

/// Odgovori su zasebna kolekcija, ne ugniježđeni niz: upitnik se snima
/// automatski pri svakoj promjeni, a Prisma nad MongoDB nema pozicioni upis
/// u ugniježđeni niz. Sa složenim jedinstvenim indeksom snimanje je jedan upsert.
model CobitOdgovor {
  id          String          @id @default(auto()) @map("_id") @db.ObjectId
  procjenaId  String          @db.ObjectId
  izjavaKod   String
  vrijednost  CobitVrijednost
  izmijenjeno DateTime        @updatedAt

  @@unique([procjenaId, izjavaKod])
  @@index([procjenaId])
}

// ---------------------------------------------------------------------------
// IT upitnik — dijelovi A i B                                          [M3]
// dio C                                                                [M4]
// ---------------------------------------------------------------------------

enum DioUpitnika {
  A // Opšti podaci — samo prikupljanje podataka, bez ocjene
  B // Indikatori IT rizika — ocjena rizika 1–4 po kategoriji
  C // IT kontrole — ocjena nivoa zrelosti 1–4 po podoblasti
}

enum TipOdgovora {
  BROJ
  TEKST
  DA_NE
  IZBOR
  DA_NE_DJELIMICNO
}

/// Pitanja se ugnježđuju u sekciju — isti razlog kao kod `CobitIzjava`:
/// katalog je nepromjenljiv i čita se u cjelini po ekranu dijela.
type UpitnikPitanje {
  kod         String // stabilan čitljiv kod, npr. A1-1a, C4.7-117
  redniBroj   Int
  tekst       String
  uputstvo    String // kolona G izvornog fajla; u dijelu C je prazno
  tipOdgovora TipOdgovora
  opcije      String[] // popunjeno samo za IZBOR
}

/// Sekcija je kategorija (A1–A4, B1–B5), oblast (C1–C10) ili podoblast (C1.1…).
/// `roditeljKod` je kod nadređene oblasti, ne relacija: katalog se uvijek čita
/// cijeli pa spajanje kolekcija ne bi ništa donijelo.
model UpitnikSekcija {
  id          String           @id @default(auto()) @map("_id") @db.ObjectId
  kod         String           @unique // A1, B3, C4.7…
  naziv       String
  dio         DioUpitnika
  roditeljKod String?
  redniBroj   Int
  pitanja     UpitnikPitanje[]

  @@index([dio])
}

/// Odgovor na jedno pitanje. Zasebna kolekcija iz istog razloga kao
/// `CobitOdgovor`: snimanje je automatsko, pa svaka promjena mora biti
/// jedan `upsert`, a ne prepisivanje dokumenta od stotina stavki.
model UpitnikOdgovor {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  procjenaId   String   @db.ObjectId
  pitanjeKod   String
  vrijednost   String? // kolona E izvornog fajla
  objasnjenje  String? // kolona F; u dijelu C se ne koristi
  izmijenjeno  DateTime @updatedAt

  @@unique([procjenaId, pitanjeKod])
  @@index([procjenaId])
}

/// Ocjena sekcije 1–4. U izvornom fajlu je to jedna spojena ćelija (kolona H)
/// preko svih redova sekcije, zajedno sa obrazloženjima (kolone F i G dijela C) —
/// zato ocjena i obrazloženja stoje uz sekciju, a ne uz pitanje.
///
/// ⚠ Skala je 1–4 i VEĆE JE GORE, suprotno od COBIT nivoa zrelosti.
model UpitnikOcjena {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  procjenaId  String   @db.ObjectId
  sekcijaKod  String
  ocjena      Int // 1–4
  prednosti   String? // kolona F dijela C
  slabosti    String? // kolona G dijela C
  izmijenjeno DateTime @updatedAt

  @@unique([procjenaId, sekcijaKod])
  @@index([procjenaId])
}
